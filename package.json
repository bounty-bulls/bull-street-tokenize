{
  "name": "bull-street",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "build:contracts": "cd contracts && forge build",
    "test:contracts": "cd contracts && forge test",
    "gen": "pnpm --filter @bullstreet/shared gen",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "e2e": "tsx scripts/e2e.ts",
    "chain": "anvil --port 8545",
    "deploy:local": "tsx scripts/deploy.ts local",
    "deploy:arc": "tsx scripts/deploy.ts arc",
    "seed": "tsx scripts/seed.ts",
    "api": "pnpm --filter @bullstreet/api start",
    "workers": "pnpm --filter @bullstreet/workers start",
    "dev": "pnpm --filter @bullstreet/app dev"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "pnpm": {
    "overrides": {
      "viem": "2.57.13"
    }
  }
}
