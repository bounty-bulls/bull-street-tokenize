# ----------------------------------------------------------------- chain
# Arc testnet: 5042002. Local anvil: 31337.
CHAIN_ID=5042002
RPC_URL=https://rpc.testnet.arc.network
# USDC ERC-20 interface on Arc (6 decimals). Leave unset on a local chain (a MockUSDC is deployed).
USDC_ADDRESS=0x3600000000000000000000000000000000000000
CALENDAR_MODE=compressed           # compressed | nse
DEMO_SCALE=10                      # divides tier caps and minimum bonds

# ----------------------------------------------------------------- keys (testnet only, never commit)
DEPLOYER_PRIVATE_KEY=
# 12-word mnemonic for the oracle signers, keeper, broker agents and seed personas
DEMO_MNEMONIC=
# server key that signs World ID role attestations
WORLD_ATTESTOR_PRIVATE_KEY=
# optional overrides
ORACLE_PKS=
KEEPER_PRIVATE_KEY=
TREASURY=

# ----------------------------------------------------------------- World ID (developer.worldcoin.org)
NEXT_PUBLIC_WORLD_APP_ID=
NEXT_PUBLIC_WORLD_RP_ID=
NEXT_PUBLIC_WORLD_ENV=staging
WORLD_RP_SIGNING_KEY=
WORLD_ACTION=bullstreet-role-v1
ALLOW_DEV_IDENTITY=false

# ----------------------------------------------------------------- market data
TWELVEDATA_API_KEY=

# ----------------------------------------------------------------- Circle Modular Wallets (console.circle.com)
NEXT_PUBLIC_CIRCLE_CLIENT_KEY=
NEXT_PUBLIC_CIRCLE_CLIENT_URL=

# ----------------------------------------------------------------- services
API_PORT=8790
# DB_PATH=            # optional; defaults to data/bullstreet-<CHAIN_ID>.sqlite
NEXT_PUBLIC_API_URL=http://localhost:8790
